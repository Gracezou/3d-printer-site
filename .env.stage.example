# Stage 应用运行配置。复制为 .env.stage，填写后执行 chmod 600 .env.stage。
# Stage 与生产必须使用两份独立文件，严禁从 .env.dev 或 .env.production 复制密钥。

APP_ENV=staging
# APP_VERSION 由镜像内置为 v0.3.0+sha-<commit>；保持此键注释，避免覆盖镜像版本。
# APP_VERSION=
LOG_LEVEL=info

# 推荐使用 Supabase Session pooler 连接串（端口 5432）。直连地址依赖
# IPv6；仅在主机具备 IPv6 或项目已购买 IPv4 附加服务时使用直连。
DATABASE_URL=
DATABASE_POOL_MAX=3
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=products
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

ADMIN_JWT_SECRET=
SESSION_COOKIE_SECURE=true

ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ICP_LICENSE=
CRON_SECRET=

ENABLE_MOCK_PAYMENT=false
DEMO_ADMIN_PASSWORD=
ALLOW_DEMO_DATA=false
CONFIRM_PREPROD_RESET=
