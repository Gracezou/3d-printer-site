# 应用环境标识。本地使用 development；预生产使用 staging；正式环境使用 production。
APP_ENV=development

# 应用版本，健康检查接口会返回该值。
APP_VERSION=development

# 服务端日志级别，可选 trace/debug/info/warn/error/fatal。
LOG_LEVEL=info

# ==============================================================================
# 数据库与 Supabase
# ==============================================================================

# PostgreSQL 连接串，供 Drizzle/Postgres.js 在服务端使用。
# 建议使用 Supabase 提供的连接池地址；格式：postgresql://用户:密码@主机:端口/数据库
DATABASE_URL=

# 单个应用实例最多保持的数据库连接数。Supabase 小型连接池建议设为 3～5；默认值为 5。
DATABASE_POOL_MAX=5

# Supabase 项目地址，仅供服务端封装使用，例如：https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase service_role 密钥，仅允许服务端使用。
# 严禁添加 NEXT_PUBLIC_ 前缀、提交真实值或输出到日志。
SUPABASE_SERVICE_ROLE_KEY=

# 商品图片和 GLB 模型使用的公开 Storage bucket；需预先在 Supabase 中创建。
SUPABASE_STORAGE_BUCKET=products

# Supabase 项目地址，供浏览器端邮箱 OTP Auth 使用；通常与 SUPABASE_URL 相同。
# 邮件模板需显示 {{ .Token }}；OTP 长度可配置为 6 至 10 位；对外验证前请配置自定义 SMTP。
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key，供浏览器端登录流程使用；不要填写 service_role 密钥。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ==============================================================================
# 后台鉴权
# ==============================================================================

# 后台 JWT 的 HS256 签名密钥，仅服务端使用，至少 32 个随机字符。
# 可使用 `openssl rand -base64 48` 生成。
ADMIN_JWT_SECRET=

# ==============================================================================
# 支付宝支付
# ==============================================================================

# 支付宝开放平台应用 ID。
ALIPAY_APP_ID=

# 应用私钥。多行 PEM 放入环境变量时需按部署平台要求处理换行。
ALIPAY_PRIVATE_KEY=

# 支付宝公钥，用于异步通知验签；不是应用公钥。
ALIPAY_PUBLIC_KEY=

# 支付宝网关。生产环境使用默认值，沙箱联调时替换为沙箱网关。
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 支付宝异步通知地址，必须是公网可访问的 HTTPS 地址。
# 示例：https://example.com/api/payments/alipay/notify
ALIPAY_NOTIFY_URL=

# 用户完成支付后的同步跳转地址，仅用于页面导航，不能作为支付成功依据。
# 示例：https://example.com/api/payments/alipay/return
ALIPAY_RETURN_URL=

# ==============================================================================
# 站点公开配置
# ==============================================================================

# 站点对外访问根地址，不带末尾斜杠；本地开发保持默认值即可。
NEXT_PUBLIC_SITE_URL=http://localhost:5003

# 工信部 ICP 备案号，展示在前台页脚；未备案的本地环境可留空。
NEXT_PUBLIC_ICP_LICENSE=

# ==============================================================================
# 定时任务
# ==============================================================================

# Cron 接口 Bearer Token，仅服务端和任务调度平台持有，建议至少 32 个随机字符。
CRON_SECRET=

# ==============================================================================
# 功能开关
# ==============================================================================

# 是否启用本地 Mock 支付 Provider；生产环境必须保持 false。
ENABLE_MOCK_PAYMENT=false

# 可选：v0.1 演示运营员密码；留空则每次重建演示数据时随机生成并输出。
# 仅用于虚构测试数据，不得复用生产账号密码。
DEMO_ADMIN_PASSWORD=

# 生产模式默认禁止播种演示数据。
# 仅隔离验证环境需要演示数据时才允许设为 true。
ALLOW_DEMO_DATA=false

# 预生产精简数据重置确认值。日常必须留空，仅在明确重置预生产库的单次命令中传入。
CONFIRM_PREPROD_RESET=
