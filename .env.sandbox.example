# 沙箱退款回归专用环境变量模板。复制为 .env.sandbox，填写后执行 chmod 600 .env.sandbox。
#
# 安全红线：Supabase 相关键必须指向本地 Supabase（supabase start）或专用沙箱项目，
# 严禁从 .env.dev / .env.production 复制；ADMIN_JWT_SECRET 必须新生成。
# 支付宝网关（ALIPAY_GATEWAY）必须为沙箱域名（*.alipaydev.com），留空会默认走生产网关。

# ==============================================================================
# 数据库与 Supabase
# ==============================================================================

# PostgreSQL 连接串，供 Drizzle/Postgres.js 在服务端使用。
# 本模板只用于隔离本地 PostgreSQL，主机必须是 127.0.0.1 或 localhost。
DATABASE_URL=

# 单个应用实例最多保持的数据库连接数。默认值为 5。
DATABASE_POOL_MAX=

# Supabase 项目地址，仅供服务端封装使用，例如：https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase service_role 密钥，仅允许服务端使用。
# 严禁添加 NEXT_PUBLIC_ 前缀、提交真实值或输出到日志。
SUPABASE_SERVICE_ROLE_KEY=

# 商品图片和售后凭证使用的公开 Storage bucket；需预先在 Supabase 中创建。
SUPABASE_STORAGE_BUCKET=products

# Supabase 项目地址，供浏览器端邮箱 OTP Auth 使用；通常与 SUPABASE_URL 相同。
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key，供浏览器端登录流程使用；不要填写 service_role 密钥。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ==============================================================================
# 后台鉴权
# ==============================================================================

# 后台 JWT 的 HS256 签名密钥，仅服务端使用，至少 32 个随机字符。
# 必须新生成（示例：openssl rand -base64 48），禁止复用现网值。
ADMIN_JWT_SECRET=

# ==============================================================================
# 支付宝支付（沙箱）
# ==============================================================================

# 支付宝开放平台沙箱应用 ID。
ALIPAY_APP_ID=

# 应用私钥。多行 PEM 放入环境变量时需按部署平台要求处理换行。
ALIPAY_PRIVATE_KEY=

# 支付宝公钥，用于异步通知验签；不是应用公钥。
ALIPAY_PUBLIC_KEY=

# 支付宝网关：必须为沙箱域名（*.alipaydev.com）；留空会默认走生产网关。
ALIPAY_GATEWAY=

# 支付宝异步通知地址，必须是公网可访问的 HTTPS 地址。
ALIPAY_NOTIFY_URL=

# 用户完成支付后的同步跳转地址，仅用于页面导航，不能作为支付成功依据。
ALIPAY_RETURN_URL=

# ==============================================================================
# 功能开关
# ==============================================================================

# 是否启用本地 Mock 支付 Provider；沙箱退款回归必须为 false。
ENABLE_MOCK_PAYMENT=false

# ==============================================================================
# 站点公开配置
# ==============================================================================

# 站点对外访问根地址，不带末尾斜杠。
NEXT_PUBLIC_SITE_URL=
