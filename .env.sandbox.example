# ==============================================================================
# 沙箱退款回归专用环境变量模板（值全部留空，由执行者按需填入）
# 安全红线：Supabase 相关键必须指向本地 Supabase（supabase start）或专用沙箱项目，
# 严禁从 .env.dev / .env.production 复制；ADMIN_JWT_SECRET 必须新生成。
# ==============================================================================

# 数据库与连接池
DATABASE_URL=
DATABASE_POOL_MAX=

# Supabase 项目地址，仅供服务端封装（storage、service_role）使用。
SUPABASE_URL=

# Supabase service_role 密钥，仅允许服务端使用；严禁加 NEXT_PUBLIC_ 前缀或提交真实值。
SUPABASE_SERVICE_ROLE_KEY=

# 商品图片 / 售后凭证使用的公开 Storage bucket；需预先在 Supabase 中创建。
SUPABASE_STORAGE_BUCKET=products

# Supabase 项目地址，供浏览器端邮箱 OTP Auth 使用；通常与 SUPABASE_URL 相同。
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key，供浏览器端登录流程使用；不要填 service_role 密钥。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 后台 JWT 的 HS256 签名密钥，仅服务端使用，至少 32 个随机字符。
# 必须新生成，示例：openssl rand -base64 48
ADMIN_JWT_SECRET=

# 支付宝支付（沙箱）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 支付宝网关：必须为沙箱域名（*.alipaydev.com）；留空会默认走生产网关。
ALIPAY_GATEWAY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

# 是否启用本地 Mock 支付 Provider；沙箱退款回归必须为 false。
ENABLE_MOCK_PAYMENT=false

# 站点对外访问根地址，不带末尾斜杠。
NEXT_PUBLIC_SITE_URL=
