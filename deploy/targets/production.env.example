# 生产部署目标配置。复制为 production.env，填写后执行 chmod 600 deploy/targets/production.env。
# 本文件只描述服务器连接与发布目标，不得放应用、数据库或支付密钥。
# 推荐使用 SSH 密钥认证；密码认证要求本机安装 sshpass，安全性较弱。

# 固定填写 production；脚本会校验它与命令行目标一致。
TARGET_NAME=
# 生产服务器主机名或 IP。脚本默认不在日志中显示完整值。
SSH_HOST=
# SSH 端口，通常为 22。
SSH_PORT=
# SSH 登录用户。
SSH_USER=
# 认证方式：key 或 password；推荐 key。
SSH_AUTH=
# SSH_AUTH=key 时填写本机私钥路径；私钥自身权限也应为 0600。
SSH_KEY_PATH=
# SSH_AUTH=password 时填写；要求本机安装 sshpass。密钥认证时保持为空。
SSH_PASSWORD=
# 服务器部署目录，目录中需已有 compose.yaml 与对应 release 脚本。
DEPLOY_DIR=
# 发布模式：blue-green 或 low-memory。
RELEASE_MODE=
# 生产站点根 URL，用于发布后首页检查。
SITE_URL=
# 生产健康检查 URL，通常为 SITE_URL/api/health。
HEALTH_URL=
# GHCR 镜像仓库，不含标签，例如 ghcr.io/owner/repository。
IMAGE_REPO=
# 生产只允许填写 .env.production；文件权限必须为 0600。
APP_RUNTIME_ENV_FILE=
# 数据库完整身份，格式 host:port/database?user=username；必须与 DATABASE_URL 完全一致。
# Supabase 共享连接池必须填写包含项目 ref 的用户名，例如 postgres.<project-ref>。
DB_IDENTITY=
