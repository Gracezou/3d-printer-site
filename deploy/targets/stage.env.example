# Stage 部署目标配置。复制为 stage.env，填写后执行 chmod 600 deploy/targets/stage.env。
# 本文件只描述服务器连接与发布目标，不得放应用、数据库或支付密钥。
# 推荐使用 SSH 密钥认证；密码认证要求本机安装 sshpass，安全性较弱。

# 固定填写 stage；脚本会校验它与命令行目标一致。
TARGET_NAME=
# Stage 服务器主机名或 IP。脚本默认不在日志中显示完整值。
SSH_HOST=
# SSH 端口，通常为 22。
SSH_PORT=
# SSH 登录用户。
SSH_USER=
# 认证方式：key 或 password；推荐 key。
SSH_AUTH=
# SSH_AUTH=key 时填写本机私钥路径；私钥自身权限也应为 0600。
SSH_KEY_PATH=
# SSH_AUTH=password 时填写；要求本机安装 sshpass。密钥认证时保持为空。
SSH_PASSWORD=
# 服务器部署目录，目录中需已有 compose.yaml 与对应 release 脚本。
DEPLOY_DIR=
# 发布模式：blue-green 或 low-memory。
RELEASE_MODE=
# Stage 站点根 URL，用于发布后首页检查。
SITE_URL=
# Stage 健康检查 URL，通常为 SITE_URL/api/health。
HEALTH_URL=
# GHCR 镜像仓库，不含标签，例如 ghcr.io/owner/repository。
IMAGE_REPO=
# 本机独立的 Stage 应用运行配置，例如 .env.stage；文件权限必须为 0600。
APP_RUNTIME_ENV_FILE=
# 远程迁移的数据库 host 二次确认值，必须与 DATABASE_URL 的 hostname 完全一致。
DB_MIGRATION_HOST_CONFIRM=
