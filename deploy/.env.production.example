# v0.2.1 预生产/生产服务器运行时配置模板。
# 复制为 /opt/3d-printer-site/.env 后填写真实值，并执行 chmod 600；本文件禁止填写密钥。

# 应用环境。预生产固定为 staging；正式生产改为 production。
APP_ENV=staging
# APP_VERSION 由发布镜像写入 v0.2.1 + 精确 SHA，不要在运行时覆盖。
# 日志级别：生产建议 info，短时排障可改为 debug。
LOG_LEVEL=info

# Supabase PostgreSQL 连接池地址。新加坡项目建议使用 Supavisor 6543 transaction 模式。
DATABASE_URL=
# 2 核 2 GiB 单实例建议 3，避免占满 Supabase 小型连接池。
DATABASE_POOL_MAX=3

# Supabase 服务端项目地址。
SUPABASE_URL=
# Supabase service_role 密钥，只能保存在服务器，禁止添加 NEXT_PUBLIC_ 前缀。
SUPABASE_SERVICE_ROLE_KEY=
# 商品图片与 GLB 模型使用的公开 Storage bucket。
SUPABASE_STORAGE_BUCKET=products
# 浏览器端邮箱 OTP Auth 项目地址，通常与 SUPABASE_URL 相同；同时配置为 GitHub 仓库变量 PREPROD_SUPABASE_URL。
NEXT_PUBLIC_SUPABASE_URL=
# 浏览器端 anon/publishable key，不要填写 service_role 密钥；同时配置为 GitHub 仓库变量 PREPROD_SUPABASE_ANON_KEY。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 后台 JWT HS256 签名密钥，至少 32 个随机字符，可用 openssl rand -base64 48 生成。
ADMIN_JWT_SECRET=
# 会话 Cookie 是否仅允许 HTTPS。IP+HTTP 预生产临时设为 false；域名 HTTPS 和正式生产必须设为 true。
SESSION_COOKIE_SECURE=false
# 定时任务 Bearer Token，至少 32 个随机字符，可用 openssl rand -base64 48 生成。
CRON_SECRET=

# 支付宝沙箱应用 ID；正式生产上线时替换为生产应用 ID。
ALIPAY_APP_ID=
# 支付宝应用 RSA2 私钥。建议以单行 \n 形式保存，禁止输出到日志。
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（不是应用公钥），用于异步通知验签。
ALIPAY_PUBLIC_KEY=
# 预生产使用支付宝沙箱网关；正式生产改为 https://openapi.alipay.com/gateway.do。
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 支付宝异步通知地址。沙箱支付/退款验收前必须是公网可访问的 HTTPS 地址。
ALIPAY_NOTIFY_URL=
# 支付完成后的同步返回地址；只能用于页面跳转，不能作为支付成功依据。
ALIPAY_RETURN_URL=

# 预生产站点根地址，不带末尾斜杠；域名就绪前可临时使用 http://188.239.16.176:5003。
NEXT_PUBLIC_SITE_URL=http://188.239.16.176:5003
# 工信部 ICP 备案号；新加坡预生产环境留空。
NEXT_PUBLIC_ICP_LICENSE=

# 沙箱和生产环境必须关闭 Mock 支付。
ENABLE_MOCK_PAYMENT=false
# 预生产精简数据重置的安全开关；仅执行命令时临时传入，不要长期设为确认值。
CONFIRM_PREPROD_RESET=
