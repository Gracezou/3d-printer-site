# 服务器运行时配置模板，对应服务器上的 $DEPLOY_DIR/.env，由 deploy/compose.yaml 的 env_file 读取。
# 复制到服务器 /opt/3d-printer-site/.env 后填写真实值，并执行 chmod 600；本文件禁止填写真实密钥。

# ==============================================================================
# 应用运行
# ==============================================================================

# 应用环境标识。预生产固定为 staging；正式生产改为 production。
APP_ENV=staging

# 应用版本。由发布镜像写入 v0.3.0+sha-<commit>；保持此键注释，避免覆盖镜像版本。
# APP_VERSION=

# 服务端日志级别，可选 trace/debug/info/warn/error/fatal；生产建议 info，短时排障可改 debug。
LOG_LEVEL=info

# ==============================================================================
# 数据库与 Supabase
# ==============================================================================

# PostgreSQL 连接串，供 Drizzle/Postgres.js 在服务端使用。
# 推荐使用 Supabase Session pooler 连接串（端口 5432）。直连 db.<project-ref>.supabase.co
# 依赖 IPv6，仅在运行主机具备 IPv6 或项目已购买 IPv4 附加服务时使用直连。
DATABASE_URL=

# 单个应用实例最多保持的数据库连接数。2 核 2 GiB 单实例建议 3，避免占满 Supabase 小型连接池。
DATABASE_POOL_MAX=3

# Supabase 项目地址，仅供服务端封装使用，例如：https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase service_role 密钥，仅允许服务端使用。
# 严禁添加 NEXT_PUBLIC_ 前缀、提交真实值或输出到日志。
SUPABASE_SERVICE_ROLE_KEY=

# 商品图片和 GLB 模型使用的公开 Storage bucket；需预先在 Supabase 中创建。
SUPABASE_STORAGE_BUCKET=products

# Supabase 项目地址，供浏览器端邮箱 OTP Auth 使用；通常与 SUPABASE_URL 相同。
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key，供浏览器端登录流程使用；不要填写 service_role 密钥。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ==============================================================================
# 后台鉴权
# ==============================================================================

# 后台 JWT 的 HS256 签名密钥，仅服务端使用，至少 32 个随机字符。
# 可使用 `openssl rand -base64 48` 生成。
ADMIN_JWT_SECRET=

# 会话 Cookie 是否仅允许 HTTPS。IP+HTTP 预生产临时设为 false；域名 HTTPS 与正式生产必须设为 true。
SESSION_COOKIE_SECURE=false

# ==============================================================================
# 定时任务
# ==============================================================================

# Cron 接口 Bearer Token，仅服务端和任务调度平台持有，至少 32 个随机字符。
# 可使用 `openssl rand -base64 48` 生成。
CRON_SECRET=

# ==============================================================================
# 支付宝支付
# ==============================================================================

# 支付宝开放平台应用 ID。预生产使用沙箱应用 ID；正式生产替换为生产应用 ID。
ALIPAY_APP_ID=

# 应用私钥。多行 PEM 放入环境变量时需按部署平台要求处理换行。
ALIPAY_PRIVATE_KEY=

# 支付宝公钥，用于异步通知验签；不是应用公钥。
ALIPAY_PUBLIC_KEY=

# 支付宝网关。预生产使用沙箱网关；正式生产改为生产网关 https://openapi.alipay.com/gateway.do。
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# 支付宝异步通知地址，必须是公网可访问的 HTTPS 地址。
# 示例：https://example.com/api/payments/alipay/notify
ALIPAY_NOTIFY_URL=

# 用户完成支付后的同步跳转地址，仅用于页面导航，不能作为支付成功依据。
# 示例：https://example.com/api/payments/alipay/return
ALIPAY_RETURN_URL=

# ==============================================================================
# 站点公开配置
# ==============================================================================

# 站点对外访问根地址，不带末尾斜杠。
NEXT_PUBLIC_SITE_URL=

# 工信部 ICP 备案号，展示在前台页脚；新加坡预生产环境留空。
NEXT_PUBLIC_ICP_LICENSE=

# ==============================================================================
# 功能开关
# ==============================================================================

# 是否启用本地 Mock 支付 Provider；沙箱和生产环境必须保持 false。
ENABLE_MOCK_PAYMENT=false

# 预生产精简数据重置确认值。日常必须留空，仅在明确重置预生产库的单次命令中传入。
CONFIRM_PREPROD_RESET=
