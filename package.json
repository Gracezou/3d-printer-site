{
  "name": "3d-printer-site",
  "version": "0.2.1",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "dotenv -e .env.dev -- next dev --turbopack --port 5003",
    "build": "dotenv -e .env.dev -- next build",
    "build:production": "next build",
    "start": "dotenv -e .env.dev -- next start --port 5003",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:acceptance": "./scripts/run-acceptance-v01.sh",
    "security:audit": "./scripts/security-audit.sh",
    "db:generate": "dotenv -e .env.dev -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.dev -- drizzle-kit migrate",
    "db:check": "dotenv -e .env.dev -- tsx scripts/check-db.ts",
    "db:seed": "dotenv -e .env.dev -- tsx scripts/seed.ts",
    "demo:seed": "dotenv -e .env.dev -- tsx scripts/demo-data.ts seed",
    "demo:reset": "dotenv -e .env.dev -- tsx scripts/demo-data.ts reset",
    "demo:check": "dotenv -e .env.dev -- tsx scripts/demo-data.ts check",
    "preprod:data:check": "dotenv -e .env.production -- tsx scripts/preprod-data.ts check",
    "preprod:data:reset": "dotenv -e .env.production -- tsx scripts/preprod-data.ts reset",
    "test:inventory": "dotenv -e .env.dev -- tsx scripts/test-inventory-sql.ts",
    "test:admin-auth": "dotenv -e .env.dev -- tsx scripts/test-admin-auth.ts",
    "test:super-admin": "dotenv -e .env.dev -- tsx scripts/test-super-admin-role.ts",
    "test:materials": "dotenv -e .env.dev -- tsx scripts/test-material-service.ts",
    "test:categories": "dotenv -e .env.dev -- tsx scripts/test-category-service.ts",
    "test:products": "dotenv -e .env.dev -- tsx scripts/test-product-service.ts",
    "test:upload": "dotenv -e .env.dev -- tsx scripts/test-upload-service.ts",
    "test:availability": "dotenv -e .env.dev -- tsx scripts/test-availability-service.ts",
    "test:storefront": "dotenv -e .env.dev -- tsx scripts/test-storefront-products.ts",
    "test:product-detail": "dotenv -e .env.dev -- tsx scripts/test-product-detail.ts",
    "test:cart": "dotenv -e .env.dev -- tsx scripts/test-cart-service.ts",
    "test:addresses": "dotenv -e .env.dev -- tsx scripts/test-address-service.ts",
    "test:customer-profile": "dotenv -e .env.dev -- tsx scripts/test-customer-profile.ts",
    "test:pricing": "dotenv -e .env.dev -- tsx scripts/test-pricing-services.ts",
    "test:order-preview": "dotenv -e .env.dev -- tsx scripts/test-order-preview.ts",
    "test:order-create": "dotenv -e .env.dev -- tsx scripts/test-order-creation.ts",
    "test:order-concurrency": "dotenv -e .env.dev -- tsx scripts/test-order-concurrency.ts",
    "test:admin-orders": "dotenv -e .env.dev -- tsx scripts/test-admin-orders.ts",
    "test:promotions": "dotenv -e .env.dev -- tsx scripts/test-promotions.ts",
    "test:payments": "dotenv -e .env.dev -- tsx scripts/test-payments.ts",
    "test:refunds": "dotenv -e .env.dev -- tsx scripts/test-refunds.ts",
    "test:production": "dotenv -e .env.dev -- tsx scripts/test-production-dashboard.ts",
    "test:discount-codes": "dotenv -e .env.dev -- tsx scripts/test-discount-codes.ts",
    "test:customer-orders": "dotenv -e .env.dev -- tsx scripts/test-customer-orders.ts",
    "test:admin-users": "dotenv -e .env.dev -- tsx scripts/test-admin-users.ts",
    "test:admin-access": "dotenv -e .env.dev -- tsx scripts/test-admin-access.ts",
    "test:admin-settings": "dotenv -e .env.dev -- tsx scripts/test-admin-settings.ts",
    "test:cron": "dotenv -e .env.dev -- tsx scripts/test-cron.ts",
    "test:alipay": "dotenv -e .env.dev -- tsx scripts/test-alipay-provider.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "alipay-sdk": "4.14.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.24",
    "pino": "^9.6.0",
    "postgres": "^3.4.7",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.185.4",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.24",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
